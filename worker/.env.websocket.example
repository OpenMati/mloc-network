# WebSocket Worker 环境变量配置示例

# ============================================
# WebSocket 配置
# ============================================

# 启用 WebSocket 传输（替代 Redis Pub/Sub）
# 可选值：true, false, 1, 0, yes, no
WORKER_USE_WEBSOCKET=true

# Orchestrator 基础 URL（启用 WebSocket 时必需）
# WebSocket 将连接到：ws://{host}/ws/worker/{worker_id}
ORCHESTRATOR_BASE_URL=http://localhost:8000

# ============================================
# Worker 基础配置
# ============================================

# Worker 唯一标识符（可选，不设置则自动生成）
WORKER_ID=worker-websocket-001

# Redis URL（仍用于 worker 注册和状态管理）
REDIS_URL=redis://localhost:6379/0

# Worker 标签（逗号分隔，用于任务匹配）
WORKER_TAGS=gpu,inference,websocket

# Worker 成本（每小时美元）
WORKER_COST_PER_HOUR=3.5

# ============================================
# 任务配置
# ============================================

# 任务 topic（WebSocket 模式下仅用于兼容性）
TASK_TOPIC=tasks

# 结果输出目录
RESULTS_DIR=./results_workers

# ============================================
# 心跳配置
# ============================================

# 心跳间隔（秒）
HEARTBEAT_INTERVAL_SEC=30

# 心跳 TTL（秒，自动计算为间隔的4倍，最少120秒）
# HEARTBEAT_TTL_SEC=120

# ============================================
# 日志配置
# ============================================

# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# 使用说明
# ============================================
# 
# 1. 启用 WebSocket 模式：
#    export WORKER_USE_WEBSOCKET=true
#    export ORCHESTRATOR_BASE_URL=http://orchestrator:8000
#    python -m worker.main
# 
# 2. 禁用 WebSocket（使用 Redis）：
#    export WORKER_USE_WEBSOCKET=false
#    python -m worker.main
# 
# 3. Docker Compose：
#    环境变量直接写入 docker-compose.yml 的 environment 部分
#
